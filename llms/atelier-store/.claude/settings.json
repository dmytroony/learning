{
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm exec tsc *)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  }
}